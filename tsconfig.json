{
  "compilerOptions": {
    "target": "es2020",
    "module": "CommonJS",
    "allowJs": true,
    "declaration": true,
    "inlineSourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true
  },
  "include": [
    "src",
    "src/types.ts"
  ]
}